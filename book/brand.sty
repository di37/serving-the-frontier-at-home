% --- Typography ---
\ifTUTeX
  \RequirePackage{fontspec}
  % Original LaTeX look: fontspec defaults to Latin Modern (user preference).
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
\fi

\color{navy}
\setstretch{1.15}
\setlength{\parskip}{0.4em}
\setlength{\parindent}{0pt}

\titleformat{\section}{\Large\bfseries\color{navy}}{\thesection}{0.6em}{}[\vspace{2pt}{\color{teal}\titlerule[2pt]}]
\titleformat{\subsection}{\large\bfseries\color{navy}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{teal}}{\thesubsubsection}{0.4em}{}
\titlespacing*{\section}{0pt}{16pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

\captionsetup{font={small,color=brandgray},labelfont={bf,color=brandgray}}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}

\hypersetup{
  colorlinks=true,
  linkcolor=brandblue,
  urlcolor=brandblue,
  citecolor=brandblue,
}

% --- Listings (code) ---
\lstset{
  basicstyle=\ttfamily\small\color{brandcyan},
  backgroundcolor=\color{navy},
  keywordstyle=\color{teal}\bfseries,
  commentstyle=\color{brandgray}\itshape,
  stringstyle=\color{mist},
  identifierstyle=\color{mist},
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  tabsize=4,
  frame=none,
  aboveskip=0pt,
  belowskip=0pt,
  xleftmargin=0pt,
  xrightmargin=0pt,
}

% --- Document metadata keys ---
\newcommand{\brand@title}{Document Title}
\newcommand{\brand@subtitle}{}
\newcommand{\brand@author}{\brandname}
\newcommand{\brand@date}{\today}
\newcommand{\brand@category}{}
\newcommand{\brand@version}{}
\newcommand{\brand@doctype}{guide}

\pgfkeys{
  /brand/.is family, /brand/.cd,
  title/.store in=\brand@title,
  subtitle/.store in=\brand@subtitle,
  author/.store in=\brand@author,
  date/.store in=\brand@date,
  category/.store in=\brand@category,
  version/.store in=\brand@version,
  doctype/.store in=\brand@doctype,
}

