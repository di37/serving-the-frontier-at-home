% --- Page setup ---
\geometry{a4paper,top=2.5cm,bottom=2.5cm,left=2.5cm,right=2.5cm}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyhead[L]{\small\color{brandgray}\itshape\brand@title}
\fancyhead[R]{\small\color{brandgray}\brandslogan}
\fancyfoot[L]{\small\color{brandgray}Created by Isham Rashik}
\fancyfoot[R]{\small\color{brandgray}Page \thepage\ / \pageref{LastPage}}
