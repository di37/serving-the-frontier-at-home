\newcommand{\badge}[1]{%
  \tikz[baseline=(n.base)]{
    \node[fill=teal,rounded corners=8pt,inner xsep=8pt,inner ysep=3pt,font=\scriptsize\bfseries,text=white] (n) {\MakeUppercase{#1}};
  }%
}

\newcommand{\insight}[1]{%
  \begin{tcolorbox}[
    enhanced,
    breakable=false,
    colback=navy,
    colframe=navy,
    boxrule=0pt,
    arc=3pt,
    left=10pt,right=10pt,top=10pt,bottom=10pt,
    fontupper=\color{mist}\itshape,
  ]
  #1
  \end{tcolorbox}%
}

\newcommand{\metric}[3][]{%
  \begin{tcolorbox}[
    enhanced,
    hbox,
    colback=ice,
    colframe=lightgray,
    boxrule=0.4pt,
    arc=3pt,
    left=8pt,right=8pt,top=6pt,bottom=6pt,
  ]
  {\scriptsize\color{brandgray}\MakeUppercase{#2}}\\[2pt]
  {\large\bfseries\color{navy}#3}%
  \ifstrempty{#1}{}{\ {\color{teal}#1}}
  \end{tcolorbox}%
}

\newcommand{\divider}{%
  \par\vspace{8pt}\noindent{\color{lightgray}\hrule height 1pt}\vspace{8pt}\par
}

\newcommand{\brandfooter}{%
  \divider
  {\small\color{brandgray}%
  \textit{\brandname{} --- \brandtitle{} \textperiodcentered{} \brandslogan}\\
  \textit{\branddescriptor}\\
  \textit{\brandgithub{} \textperiodcentered{} \brandhuggingface{} \textperiodcentered{} \brandlocation}}%
}

\newcommand{\brandcta}[1][linkedin-qr.png]{%
  \clearpage
  \vspace*{\fill}
  \noindent
  \begin{minipage}[c]{0.72\textwidth}
    {\Large\bfseries\color{navy}Follow me for More AI Content}\\[8pt]
    {\color{navy}If you found these notes useful, connect with me on LinkedIn for more deep dives into Machine Learning, Artificial Intelligence, and Computer Vision.}\\[12pt]
    \href{\brandlinkedinurl}{\textbf{\color{brandblue}Isham Rashik on LinkedIn}}\\[4pt]
    {\small\color{brandgray}Scan the QR code or click the link above}
  \end{minipage}%
  \hfill
  \begin{minipage}[c]{0.24\textwidth}
    \IfFileExists{#1}{%
      \includegraphics[width=\linewidth]{#1}%
    }{%
      \fbox{\parbox{\linewidth}{\centering\small\color{brandgray}QR}}%
    }
  \end{minipage}
  \vspace*{\fill}
}

% --- Callout boxes ---
\newcommand{\brand@clue}[4]{%
  \newtcolorbox{#1}[1][#3]{%
    enhanced,
    breakable=false,
    colback=#2!10,
    colframe=#2,
    boxrule=0.4pt,
    leftrule=3pt,
    arc=2pt,
    left=8pt,right=8pt,top=6pt,bottom=6pt,
    coltitle=#2,
    fonttitle=\bfseries\sffamily,
    colbacktitle=#2!12,
    title={#4##1},
    attach boxed title to top left={yshift=-2pt,xshift=8pt},
    boxed title style={boxrule=0pt,colframe=white,arc=1pt},
  }%
}

% Environments: optional argument overrides the default title
\brand@clue{abstractbox}{clueabstract}{Abstract}{}
\brand@clue{codebox}{cluecode}{Code}{}
\brand@clue{conclusion}{clueconclusion}{Conclusion}{}
\brand@clue{danger}{cluedanger}{Danger}{}
\brand@clue{errorbox}{clueerror}{Error}{}
\brand@clue{example}{clueexample}{Example}{}
\brand@clue{experiment}{clueexperiment}{Experiment}{}
\brand@clue{goal}{cluegoal}{Goal}{}
\brand@clue{idea}{clueidea}{Idea}{}
\brand@clue{info}{clueinfo}{Info}{}
\brand@clue{memo}{cluememo}{Memo}{}
\brand@clue{notify}{cluenotify}{Notify}{}
\brand@clue{question}{cluequestion}{Question}{}
\brand@clue{quotebox}{cluequotation}{Quote}{}
\brand@clue{success}{cluesuccess}{Success}{}
\brand@clue{task}{cluetask}{Task}{}
\brand@clue{tip}{cluetip}{Tip}{}
\brand@clue{warningbox}{cluewarning}{Warning}{}

% Custom clue: \begin{clue}[title=..., accent=teal]
\newtcolorbox{clue}[1][]{%
  enhanced,
  breakable=false,
  colback=ice,
  colframe=navy,
  boxrule=0.4pt,
  leftrule=3pt,
  arc=2pt,
  left=8pt,right=8pt,top=6pt,bottom=6pt,
  coltitle=navy,
  fonttitle=\bfseries\sffamily,
  #1,
}

% --- Decision framework ---
\newcounter{brandstep}
\newenvironment{decision}{%
  \begin{tcolorbox}[
    enhanced,
    breakable=false,
    colback=ice,
    colframe=lightgray,
    boxrule=0.4pt,
    arc=3pt,
    left=10pt,right=10pt,top=8pt,bottom=8pt,
  ]
}{\end{tcolorbox}}

\newcommand{\decisionitem}[3]{%
  {\color{teal}\bfseries If #1} $\rightarrow$ {\color{navy}\bfseries #2} --- #3\par
}

% --- Steps ---
\newenvironment{steps}{\setcounter{brandstep}{0}}{}
\newcommand{\stepitem}[2]{%
  \stepcounter{brandstep}%
  \par\noindent
  \tikz[baseline=(n.base)]{\node[fill=teal,circle,inner sep=3pt,font=\scriptsize\bfseries,text=white] (n) {\thebrandstep};}%
  \hspace{6pt}{\bfseries\color{navy}#1}%
  \ifstrempty{#2}{}{ --- #2}\par
}

% --- Comparison ---
\newcommand{\comparison}[4]{%
  \noindent
  \begin{minipage}[t]{0.48\textwidth}
    \begin{tcolorbox}[enhanced,breakable=false,colback=ice,colframe=teal,boxrule=0.8pt,arc=3pt,left=8pt,right=8pt,top=8pt,bottom=8pt]
      {\bfseries\color{teal}#1}\\[4pt]
      #2
    \end{tcolorbox}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.48\textwidth}
    \begin{tcolorbox}[enhanced,breakable=false,colback=ice,colframe=brandcyan,boxrule=0.8pt,arc=3pt,left=8pt,right=8pt,top=8pt,bottom=8pt]
      {\bfseries\color{brandcyan}#3}\\[4pt]
      #4
    \end{tcolorbox}
  \end{minipage}\par
}

% --- Tables ---
\newcommand{\brand@tableheader}[1]{\cellcolor{navy}{\color{white}\bfseries #1}}
\newcommand{\brandheader}[1]{\cellcolor{navy}{\color{white}\bfseries #1}}

\NewDocumentCommand{\brandedtable}{m m o}{%
  \begin{table}[ht]
    \centering
    \IfValueT{#3}{\caption{#3}}
    \rowcolors{2}{ice}{white}
    \begin{tabular}{#1}
      \hline
      #2
      \hline
    \end{tabular}
  \end{table}%
}

\NewDocumentCommand{\resultstable}{m m o}{%
  \brandedtable{#1}{#2}[#3]%
}

% --- Captioned / uncaptioned code ---
\newtcblisting{codeblock}[1][Python]{%
  enhanced,
  breakable=false,
  colback=navy,
  colframe=codestroke,
  boxrule=0.4pt,
  borderline west={3pt}{0pt}{teal},
  arc=3pt,
  left=6pt,right=6pt,top=0pt,bottom=0pt,
  listing only,
  listing options={language=#1,basicstyle=\ttfamily\small\color{brandcyan},keywordstyle=\color{teal}\bfseries,commentstyle=\color{brandgray}\itshape,stringstyle=\color{mist},identifierstyle=\color{mist},backgroundcolor=\color{navy},breaklines=true,showstringspaces=false},
  title={\scriptsize\ttfamily\bfseries\color{white}\MakeUppercase{#1}},
  colbacktitle=codeheader,
  coltitle=white,
  attach boxed title to top left={yshift=0pt},
  boxed title style={boxrule=0pt,colframe=codeheader,arc=0pt},
}

\newtcblisting{brandedcode}[2][Python]{%
  enhanced,
  breakable=false,
  colback=navy,
  colframe=codestroke,
  boxrule=0.4pt,
  borderline west={3pt}{0pt}{teal},
  arc=3pt,
  left=6pt,right=6pt,top=0pt,bottom=2pt,
  listing only,
  listing options={language=#1,basicstyle=\ttfamily\small\color{brandcyan},keywordstyle=\color{teal}\bfseries,commentstyle=\color{brandgray}\itshape,stringstyle=\color{mist},identifierstyle=\color{mist},backgroundcolor=\color{navy},breaklines=true,showstringspaces=false},
  title={\scriptsize\ttfamily\bfseries\color{white}\MakeUppercase{#1}},
  colbacktitle=codeheader,
  coltitle=white,
  attach boxed title to top left={yshift=0pt},
  boxed title style={boxrule=0pt,colframe=codeheader,arc=0pt},
  after lower={\vspace{4pt}{\small\color{brandgray}Code: #2}},
}

% --- Diagram primitives (TikZ, no extra packages) ---
\NewDocumentCommand{\flownode}{O{ice} O{teal} m}{%
  \def\brand@nodetext{navy}%
  \ifstrequal{#1}{navy}{\def\brand@nodetext{white}}{}%
  \ifstrequal{#1}{brandblue}{\def\brand@nodetext{white}}{}%
  \begin{tikzpicture}[baseline=(n.base)]
    \node[
      draw=#2, line width=1.2pt, fill=#1, rounded corners=4pt,
      minimum width=70pt, minimum height=22pt, align=center,
      font=\scriptsize\bfseries, text=\brand@nodetext,
    ] (n) {#3};
  \end{tikzpicture}%
}

\newcommand{\flowarrow}{\quad{\color{navy}$\rightarrow$}\quad}

\newcommand{\flowrow}[1]{%
  \begin{center}#1\end{center}
}

\newenvironment{flowchart}{%
  \begin{tcolorbox}[enhanced,breakable=false,colback=white,colframe=lightgray,boxrule=0.4pt,arc=3pt,left=12pt,right=12pt,top=12pt,bottom=12pt]
  \centering
}{\end{tcolorbox}}

% Simple horizontal bar: \baritem{Label}{0.87}{87\%}[teal]
\newcommand{\baritem}[4][teal]{%
  \noindent
  \makebox[80pt][r]{\scriptsize\bfseries\color{navy}#2}\hspace{6pt}%
  \begin{tikzpicture}[baseline=-3pt]
    \fill[#1] (0,0) rectangle ({#3*6cm},0.35);
  \end{tikzpicture}%
  \hspace{4pt}{\scriptsize\color{brandgray}#4}\par\vspace{4pt}%
}

\newenvironment{barchart}{\par}{\par}

% --- Title page + body setup ---
\newcommand{\brandeddoc}[1]{%
  \pgfkeys{/brand/.cd,#1}%
  \thispagestyle{empty}
  \vspace*{\fill}
  \ifstrempty{\brand@category}{}{\badge{\brand@category}\\[8pt]}
  {\fontsize{28}{34}\selectfont\bfseries\color{navy}\brand@title\par}
  \ifstrempty{\brand@subtitle}{}{\vspace{4pt}{\Large\color{teal}\brand@subtitle\par}}
  \vspace{16pt}
  {\color{teal}\rule{0.6\textwidth}{2pt}}
  \vspace{16pt}
  {\color{navy}\textbf{\brand@author} \textperiodcentered{} \brandtitle\\
  \brandslogan\\
  \branddescriptor\par}
  \vspace{8pt}
  {\small\color{brandgray}%
    \ifstrempty{\brand@version}{}{Version: \brand@version{} \textperiodcentered{} }%
    \brand@date\par}
  \vspace*{\fill}
  {\small\color{brandgray}%
    \brandgithub{} \textperiodcentered{} \brandhuggingface\\
    \brandlinkedin\\
    \brandlocation\par}
  \clearpage
}

